# Copy this entire file into the GitHub Actions ENV_FILE secret and replace placeholders.
NEXT_PUBLIC_APP_URL=https://ohpin.newdawn.co.kr
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_DATA_MODE=supabase

# Optional: limit work per conversion request on the shared EC2 host.
RENDER_WORKERS=1
UPLOAD_CONCURRENCY=2
SLIDE_MAX_EDGE=3840

# cp .env.example .env 후 빈 값을 채운다. Next.js와 Supabase CLI가 함께 읽는다.
NEXT_PUBLIC_DATA_MODE=supabase

# `npm run supabase:start` 후 `npm run supabase:status`가 출력한 로컬 값.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=paste-local-publishable-key-here

# Google Cloud OAuth Web client. Authorized redirect URI:
# http://127.0.0.1:55321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=paste-google-client-id-here
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=paste-google-client-secret-here

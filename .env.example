# Public ClassPin app settings (publishable values only)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only app settings. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-local-secret-key
AI_REPORT_ENABLED=false
AI_REPORT_PROVIDER_MODE=fake
AI_REPORT_QUOTE_HMAC_KEY=replace-with-at-least-32-random-characters
AI_REPORT_CONFIRMATION_THRESHOLD_USD=1
AI_REPORT_HARD_CAP_USD=25
AI_REPORT_LOCAL_WORKER_URL=http://127.0.0.1:8090

# Production-only AI settings. Use exact evaluated model/provider identifiers.
AI_REPORT_GENERATION_MODEL=
AI_REPORT_GENERATION_MODEL_FAMILY=
AI_REPORT_CRITIC_MODEL=
AI_REPORT_CRITIC_MODEL_FAMILY=
AI_REPORT_OPENROUTER_PROVIDER=
AI_REPORT_PRICING_AT=
AI_REPORT_ESTIMATED_COST_PER_SLIDE_USD=
AI_REPORT_MAX_SLIDE_GENERATION_CALL_COST_USD=
AI_REPORT_MAX_SLIDE_CRITIC_CALL_COST_USD=
AI_REPORT_MAX_REPORT_GENERATION_CALL_COST_USD=
AI_REPORT_MAX_REPORT_CRITIC_CALL_COST_USD=
OPENROUTER_API_KEY=

# Production Cloud Tasks / private Cloud Run worker settings.
GOOGLE_CLOUD_PROJECT=
CLOUD_TASKS_LOCATION=asia-northeast1
CLOUD_TASKS_QUEUE=classpin-ai-reports
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
AI_REPORT_WORKER_URL=

# Worker-only aliases. Inject through Secret Manager in production.
SUPABASE_URL=http://127.0.0.1:55321
AI_REPORT_TASK_LEASE_SECONDS=600
AI_REPORT_PROVIDER_TIMEOUT_MS=120000
AI_REPORT_MAX_SLIDE_TOKENS=2200
AI_REPORT_MAX_REPORT_TOKENS=6000

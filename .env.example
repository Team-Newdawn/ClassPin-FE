# Local Supabase identity, Storage and Realtime (business data goes through REST).
NEXT_PUBLIC_DATA_MODE=rest
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# A local backend must use the same local Supabase project.
REST_API_URL=http://127.0.0.1:8080
# Production: https://ohpinbe.newdawn.co.kr (also the default when unset).
